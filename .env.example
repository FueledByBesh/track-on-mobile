MAPBOX_PUBLIC_TOKEN=pk.your_mapbox_public_token_here
API_BASE_URL=http://your-backend-host:8080
# The WEB OAuth client ID from Cloud Console — passed as serverClientId to
# Google Sign-In so the ID token's `aud` matches what the backend verifies.
GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
